{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "howwemove",
  "compatibility_date": "2026-11-01",
  // Static app: no Worker script. Cloudflare serves the Vite build in ./dist and
  // falls back to index.html for client routes such as /exercise/:id.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
